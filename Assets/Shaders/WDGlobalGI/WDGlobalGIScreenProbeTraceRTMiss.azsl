 *
 * A ray that escapes the TLAS reads the same flat analytic sky as the SDF path's escaped/exhausted rays
 * (WDGI_Sky() in WDGlobalGICommon.azsli) - same fallback, same config knobs (m_skyColorIntensity), just
 * reached via a real miss shader instead of a "ran out of cascades" branch in the sphere-tracer loop.
 *
 * Also doubles as the shadow-ray miss: WDGlobalGIScreenProbeTraceRTClosestHit.azsl's sun-visibility trace
 * sets RAY_FLAG_SKIP_CLOSEST_HIT_SHADER, so on an obstructed shadow ray this shader never runs and the
 * payload's zero-initialised m_hitT (>= 0) is read as "occluded"; only reaching here (unobstructed) sets
 * it negative.
 */

#include "WDGlobalGIScreenProbeTraceRTCommon.azsli"

[shader("miss")]
void Miss(inout WDGiRtPayload payload)
{
    payload.m_hitT = -1.0f;
    payload.m_radiance = WDGI_Sky(WorldRayDirection());
}
