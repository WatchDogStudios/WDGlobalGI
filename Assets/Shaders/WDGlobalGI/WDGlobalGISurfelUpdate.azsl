 *
 * Surfel GI: per-surfel irradiance update. A round-robin fraction of the surfels re-trace a small
 * hemisphere ray set through the voxel scene each frame and blend it into their accumulated
 * irradiance. Because a surfel never moves, this estimate converges instead of churning - the
 * world-stable counterpart to the per-frame screen-probe signal. Long-unseen or out-of-window
 * surfels retire here (radius = 0 frees the slot for the spawn ring).
 */

#include <Atom/Features/SrgSemantics.azsli>
#include <WDGlobalGISharedConstants.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    RWTexture2D<float4> m_surfelData;
    Texture3D<float4>   m_radianceClipmap;
    Texture3D<float>    m_sdfClipmap;
    Texture3D<float4>   m_voxelNormalClipmap;
    Texture3D<float4>   m_anisoRadianceClipmap;
    Texture3D<float4>   m_irradianceClipmap;

    WDGLOBALGI_SHARED_CONSTANTS
}

#include <WDGlobalGICommon.azsli>
#define WDGI_TRACE_USE_CACHE
#include <WDGlobalGITrace.azsli>
#include <WDGlobalGISurfels.azsli>

#define WDGI_SURFEL_RAYS 16

[numthreads(64, 1, 1)]
void MainCS(uint3 dispatch_id : SV_DispatchThreadID)
{
    // Round-robin: 1/m_updateDivisor of the surfels re-trace per frame (same scheme as Propagate).
    uint divisor = max(PassSrg::m_updateDivisor, 1u);
    uint surfel = dispatch_id.x * divisor + (PassSrg::m_frameIndex % divisor);
    if (surfel >= WDGI_SURFEL_CAPACITY)
    {
        return;
    }

    float4 posRadius = PassSrg::m_surfelData[WDGI_SurfelDataTexel(surfel, 0)];
    if (posRadius.w <= 0.0f)
    {
        return;
    }
    float4 nrm = PassSrg::m_surfelData[WDGI_SurfelDataTexel(surfel, 1)];

    // Retire: scrolled out of the cache window, not seen by the spawn pass for ~10 s, or spawned
    // under a different Base Cell Size (radius no longer matches the grid - respawns fresh).
    int3 cell;
    float g = WDGI_SurfelGridCellSize();
    if (!WDGI_SurfelGridCell(posRadius.xyz, cell) || float(PassSrg::m_frameIndex) - nrm.w > 600.0f ||
        abs(posRadius.w - g) > 0.01f * g)
    {
        PassSrg::m_surfelData[WDGI_SurfelDataTexel(surfel, 0)] = float4(posRadius.xyz, 0.0f);
        return;
    }

    // Uniform-hemisphere Monte Carlo of E = integral(L cos): jittered Fibonacci directions mirrored
    // onto the normal's hemisphere, traced with the shared voxel sphere-tracer.
    float cell0 = PassSrg::m_cascadeCenterAndCell[0].w;
    uint seed = WDGI_Hash(surfel * 31u + PassSrg::m_frameIndex);
    float3 e = float3(0.0f, 0.0f, 0.0f);
    [loop] for (uint r = 0; r < WDGI_SURFEL_RAYS; ++r)
    {
        float3 dir = WDGI_SphereDir(r, WDGI_SURFEL_RAYS, seed);
        float cosTheta = dot(dir, nrm.xyz);
        dir = (cosTheta < 0.0f) ? -dir : dir;
        float hitDist;
        float3 radiance = WDGI_TraceVoxelRay(posRadius.xyz + dir * (cell0 * 1.5f), dir, hitDist);
        e += radiance * abs(cosTheta);
    }
    e *= WDGI_TWO_PI / float(WDGI_SURFEL_RAYS);

    // Accumulate: 1/N for fast early convergence, floored at (1 - hysteresis) so lighting changes
    // still propagate into converged surfels.
    float4 irradiance = PassSrg::m_surfelData[WDGI_SurfelDataTexel(surfel, 2)];
    float blendNew = max(1.0f / (irradiance.a + 1.0f), 1.0f - PassSrg::m_hysteresis);
    PassSrg::m_surfelData[WDGI_SurfelDataTexel(surfel, 2)] =
        float4(lerp(irradiance.rgb, e, blendNew), min(irradiance.a + 1.0f, 64.0f));
}
