 *
 * Surfel GI: clear the surfel grid. The grid is transient - rebuilt from the persistent surfel
 * positions every frame (WDGlobalGISurfelGridBuild.azsl) - so this is a plain full clear. Only the
 * count slots strictly need it, but one coalesced store of everything is simpler and just as fast.
 */

#include <Atom/Features/SrgSemantics.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    RWTexture2D<uint> m_surfelGrid;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 dispatch_id : SV_DispatchThreadID)
{
    PassSrg::m_surfelGrid[dispatch_id.xy] = 0u;
}
